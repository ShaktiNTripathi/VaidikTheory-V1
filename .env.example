# Database (MySQL) — only needed when running the API
DATABASE_URL="mysql://root:password@localhost:3306/vaidik_theory"

# API
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Frontend (production). Leave empty for local Vite proxy.
# VITE_API_URL=https://api.yourdomain.com

# Portal session signing (32+ random characters in production)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORTAL_COOKIE_NAME=vaidik_portal_session

# Email (optional). Without SMTP, OTP codes log to the console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=consult@vaidiktheory.com
# Set false in production (OTP never returned in JSON when off and NODE_ENV=production)
EXPOSE_OTP_IN_DEV=true

# PDF & email branding
BRAND_NAME=Vaidik Theory
BRAND_TAGLINE=Driver, Conductor, Lo Shu — classical numerology online
BRAND_EMAIL=consult@vaidiktheory.com
BRAND_PHONE=+91 98765 43210
